# ---------- PostgreSQL (used by docker-compose) ----------
POSTGRES_USER=leads
POSTGRES_PASSWORD=change_me
POSTGRES_DB=leads_db
POSTGRES_PORT=5432

# ---------- Redis (used by docker-compose) ----------
REDIS_PORT=6379

# ---------- Backend (API + worker) ----------
# Local dev (backend run on your machine, DB/Redis in Docker):
DATABASE_URL=postgresql://leads:change_me@localhost:5432/leads_db?schema=public
REDIS_URL=redis://localhost:6379
# When the api/worker run inside Docker, compose overrides the hosts with
# "postgres" and "redis" (service names), not localhost.

PORT=3000
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173

# Follow-up job delay in milliseconds (2 minutes)
FOLLOW_UP_DELAY_MS=120000

# ---------- Frontend (non-secret, bundled into public JS) ----------
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
